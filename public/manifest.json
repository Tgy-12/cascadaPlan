{
  "manifest_version": 3,
  "name": "CascadePlan — 8-Horizon Cascading Planner & Focus",
  "short_name": "CascadePlan",
  "version": "1.0.0",
  "description": "Minimal, fast, offline-first 8-horizon cascading planning tool with daily Pomodoro timeline for Linux developers & learners.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "cascadeplan@ubuntu.local",
      "strict_min_version": "109.0"
    }
  }
}
