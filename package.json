  },
  "keywords": [
    "planning",
    "productivity",
    "cascading-goals",
    "pomodoro",
    "offline-first",
    "browser-extension",
    "manifest-v3",
    "ubuntu",
    "linux"
  ],
  "author": "CascadePlan Contributors",
  "license": "MIT",
  "dependencies": {
    "idb": "^8.0.4",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
