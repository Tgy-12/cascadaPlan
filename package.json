{
  "name": "cascade-plan",
  "displayName": "CascadePlan",
  "version": "1.0.0",
  "description": "Offline-first 8-horizon cascading planning web app and browser extension for Ubuntu/Linux developers and learners.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:extension": "tsc && vite build && node scripts/prepare-extension.js",
